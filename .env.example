# ===== MAJBURIY =====
# @BotFather'dan olingan bot tokeni
BOT_TOKEN=

# Buyurtmalar tushadigan Telegram guruh ID'si.
# Botni guruhga qo'shing, guruhda /id deb yozing — bot ID'ni aytadi (masalan -1001234567890).
ADMIN_CHAT_ID=

# ===== IXTIYORIY =====
# Admin buyruqlarini (/stats, /stoplist ...) shaxsiy chatda ham ishlata oladiganlar.
# Telegram ID'lar vergul bilan. ID'ni bilish uchun botga /id yozing.
ADMIN_IDS=

# Admin guruhidagi xabarlar tili: uz yoki ru
ADMIN_LANG=uz

# Mini App ochiladigan https manzil. Railway'da bo'sh qoldiring — avtomatik aniqlanadi.
# VPS'da: https://sizning-domeningiz.uz
PUBLIC_URL=

# Faqat VPS + docker compose uchun: domen (Caddy HTTPS sertifikatni o'zi oladi)
DOMAIN=

# auto (tavsiya) | webhook | polling | web
#   auto    — https PUBLIC_URL bo'lsa webhook, bo'lmasa polling
#   web     — faqat Mini App sahifasi (Telegram'ga ulanmaydi, dizaynni ko'rish uchun)
BOT_MODE=auto

# Faqat kompyuterda brauzerda sinash uchun. Serverda HAR DOIM 0 bo'lsin!
DEV_MODE=0
